* { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
html, body {
  width: 100%; height: 100%; overflow: hidden;
  background: #05050a; color: #fff;
  font-family: "Segoe UI", system-ui, -apple-system, Roboto, sans-serif;
  touch-action: none; user-select: none; -webkit-user-select: none;
}
#app {
  position: relative; width: 100%; height: 100%;
  max-width: 100vw; max-height: 100vh;
  margin: 0 auto; background: #0a0a12;
}
#game {
  display: block; width: 100%; height: 100%;
  object-fit: cover; background: #1a2030;
}

.hidden { display: none !important; }

/* HUD */
#hud {
  position: absolute; inset: 0; pointer-events: none;
  z-index: 5;
}
#hud > * { pointer-events: auto; }

.hud-btn.pause {
  position: absolute; top: max(12px, env(safe-area-inset-top));
  left: max(12px, env(safe-area-inset-left));
  width: 48px; height: 48px; border-radius: 10px;
  border: 2px solid rgba(255,255,255,0.55);
  background: rgba(0,0,0,0.35); color: #fff;
  font-size: 16px; letter-spacing: 2px; cursor: pointer;
  backdrop-filter: blur(4px);
}
.timer {
  position: absolute; top: max(14px, env(safe-area-inset-top));
  right: max(16px, env(safe-area-inset-right));
  font-size: clamp(28px, 6vw, 42px); font-weight: 700;
  font-variant-numeric: tabular-nums;
  text-shadow: 0 2px 8px rgba(0,0,0,0.7);
  pointer-events: none;
}

/* Live gap / dual ET HUD */
.race-gap {
  position: absolute;
  top: max(14px, env(safe-area-inset-top));
  left: 50%; transform: translateX(-50%);
  width: min(320px, 58vw);
  background: rgba(0,0,0,0.45);
  border: 1px solid rgba(255,255,255,0.18);
  border-radius: 12px;
  padding: 6px 10px 8px;
  backdrop-filter: blur(4px);
  pointer-events: none;
  font-variant-numeric: tabular-nums;
  text-shadow: 0 1px 4px rgba(0,0,0,0.7);
}
.gap-row {
  display: flex; align-items: center; justify-content: space-between;
  gap: 8px; font-size: clamp(11px, 2.4vw, 13px); font-weight: 700;
}
.gap-row .gap-tag { opacity: 0.7; width: 42px; }
.gap-row.you { color: #7CFF3A; }
.gap-row.rival { color: #7ab8ff; }
.gap-meter {
  position: relative; height: 14px; margin: 4px 0;
  background: rgba(255,255,255,0.08); border-radius: 8px; overflow: hidden;
}
.gap-bar {
  position: absolute; top: 0; bottom: 0; left: 50%; width: 8%;
  background: linear-gradient(90deg, #7CFF3A, #5ad0ff);
  border-radius: 8px; transform: translateX(-50%);
  transition: left 0.08s linear, width 0.08s linear, background 0.15s;
}
#gap-delta {
  position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
  font-size: 9px; font-weight: 800; letter-spacing: 1px; color: #fff;
}

/* Pedals — GAS / BRAKE */
.pedal {
  position: absolute;
  width: clamp(64px, 14vw, 92px); height: clamp(64px, 14vw, 92px);
  border-radius: 16px; border: 3px solid rgba(255,255,255,0.55);
  background: rgba(0,0,0,0.4); color: #fff;
  font-size: clamp(12px, 2.8vw, 16px); font-weight: 800; letter-spacing: 1px;
  cursor: pointer; backdrop-filter: blur(4px);
  box-shadow: inset 0 0 20px rgba(255,255,255,0.05);
}
.pedal:active, .pedal.pressed {
  transform: scale(0.96);
}
.pedal-gas {
  right: max(16px, env(safe-area-inset-right));
  top: 38%;
  border-color: rgba(124,255,58,0.7);
  color: #b8ff8a;
}
.pedal-gas.pressed, .pedal-gas:active {
  background: rgba(124,255,58,0.28);
  border-color: #7CFF3A;
  color: #fff;
}
.pedal-brake {
  left: max(16px, env(safe-area-inset-left));
  top: 58%;
  border-color: rgba(255,90,90,0.65);
  color: #ffb0b0;
  width: clamp(56px, 12vw, 78px); height: clamp(56px, 12vw, 78px);
  font-size: clamp(10px, 2.2vw, 13px);
}
.pedal-brake.pressed, .pedal-brake:active {
  background: rgba(255,60,60,0.3);
  border-color: #ff5a5a;
  color: #fff;
}
@media (max-height: 420px) {
  .pedal-gas { top: 32%; }
  .pedal-brake { top: 52%; }
  .nitro { top: 36%; width: 72px; height: 72px; }
}

.nitro {
  position: absolute;
  left: max(14px, env(safe-area-inset-left));
  top: 42%; transform: translateY(-50%);
  width: 88px; height: 88px; border-radius: 50%;
  border: none; background: rgba(10,14,28,0.55);
  color: #cfe8ff; cursor: pointer;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 2px; font-size: 9px; font-weight: 700; letter-spacing: 0.5px;
  backdrop-filter: blur(3px);
}
.nitro .nitro-icon { width: 28px; height: 28px; }
.nitro .nitro-ring {
  position: absolute; inset: 0; width: 100%; height: 100%;
  transform: rotate(-90deg); pointer-events: none;
}
.nitro .nitro-ring circle {
  fill: none; stroke: #5ad0ff; stroke-width: 5;
  stroke-dasharray: 100; stroke-dashoffset: 0;
  stroke-linecap: round;
  filter: drop-shadow(0 0 4px #5ad0ff);
}
.nitro.active { color: #fff; }
.nitro.active .nitro-ring circle { stroke: #7CFF3A; }
.nitro.empty { opacity: 0.45; }

.tach {
  position: absolute; left: 50%; bottom: max(8px, env(safe-area-inset-bottom));
  transform: translateX(-50%);
  width: min(220px, 42vw); height: min(220px, 42vw);
  pointer-events: none;
}
#tach-canvas { width: 100%; height: 100%; display: block; }
.tach-readout {
  position: absolute; left: 50%; top: 54%; transform: translate(-50%, -50%);
  text-align: center; line-height: 1.05;
}
#gear-label {
  font-size: clamp(22px, 5vw, 34px); font-weight: 800;
  text-shadow: 0 2px 6px #000;
}
#gear-label span { font-size: 0.45em; margin-left: 2px; opacity: 0.85; }
#speed-label {
  font-size: clamp(26px, 6vw, 40px); font-weight: 800;
  text-shadow: 0 2px 6px #000;
}
#speed-label span {
  display: block; font-size: 0.32em; letter-spacing: 2px;
  opacity: 0.75; font-weight: 600; margin-top: 2px;
}

.shift {
  position: absolute;
  bottom: max(18px, calc(env(safe-area-inset-bottom) + 10px));
  width: clamp(72px, 16vw, 110px); height: clamp(72px, 16vw, 110px);
  border-radius: 18px;
  border: 3px solid rgba(255,255,255,0.65);
  background: rgba(255,255,255,0.08);
  color: #fff; font-size: clamp(42px, 10vw, 64px); font-weight: 300;
  line-height: 1; cursor: pointer;
  backdrop-filter: blur(4px);
  box-shadow: inset 0 0 24px rgba(255,255,255,0.06);
}
.shift:active, .shift.pressed {
  background: rgba(124,255,58,0.25);
  border-color: #7CFF3A;
}
.shift-minus { left: max(16px, env(safe-area-inset-left)); }
.shift-plus { right: max(16px, env(safe-area-inset-right)); }

.banner {
  position: absolute; left: 50%; top: 28%;
  transform: translate(-50%, -50%);
  text-align: center; pointer-events: none;
  text-shadow: 0 4px 18px rgba(0,0,0,0.85);
  opacity: 0; transition: opacity 0.12s ease;
}
.banner.show { opacity: 1; }
.banner .go {
  font-size: clamp(64px, 16vw, 110px); font-weight: 900;
  font-style: italic; color: #7CFF3A; letter-spacing: 2px;
  display: block; line-height: 0.9;
}
.banner .sub {
  font-size: clamp(18px, 4.5vw, 28px); font-weight: 700;
  color: #fff; letter-spacing: 3px; margin-top: 6px;
}
.banner .warn { color: #ff5a5a; }
.banner .ok { color: #7CFF3A; }

/* Overlays / menus */
.overlay {
  position: absolute; inset: 0; z-index: 20;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(160deg, rgba(5,8,18,0.92), rgba(10,20,40,0.88));
  padding: 24px;
}
.menu-card {
  width: min(420px, 100%); text-align: center;
  background: rgba(16,20,36,0.85);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 18px; padding: 28px 22px 24px;
  box-shadow: 0 20px 60px rgba(0,0,0,0.45);
  backdrop-filter: blur(10px);
}
.menu-card h1 {
  font-size: clamp(32px, 9vw, 44px); font-weight: 900;
  letter-spacing: 1px; line-height: 0.95; margin-bottom: 10px;
}
.menu-card h1 span { color: #7CFF3A; }
.menu-card h2 {
  font-size: clamp(26px, 7vw, 34px); font-weight: 800; margin-bottom: 16px;
}
.tagline { color: #9aa3b8; font-size: 13px; margin-bottom: 14px; }
.hint { color: #7a849c; font-size: 12px; margin-top: 16px; line-height: 1.4; }
.stats { color: #c8d0e0; margin: 8px 0 12px; font-size: 15px; line-height: 1.5; }
.payout {
  color: #7CFF3A; font-weight: 800; font-size: 18px; margin-bottom: 14px;
}

.cash-pill {
  display: inline-block;
  background: rgba(124,255,58,0.12);
  border: 1px solid rgba(124,255,58,0.45);
  color: #7CFF3A;
  font-weight: 800; font-size: 15px;
  padding: 6px 14px; border-radius: 999px;
  margin-bottom: 14px;
  font-variant-numeric: tabular-nums;
}

button.primary, button.ghost {
  display: block; width: 100%; margin: 8px 0;
  padding: 14px 16px; border-radius: 12px;
  font-size: 16px; font-weight: 800; letter-spacing: 1px;
  cursor: pointer; border: none;
}
button.primary {
  background: #7CFF3A; color: #0a1208;
  box-shadow: 0 6px 20px rgba(124,255,58,0.25);
}
button.primary:active { transform: scale(0.98); }
button.ghost {
  background: transparent; color: #fff;
  border: 1px solid rgba(255,255,255,0.28);
}
button.ghost.slim, button.slim {
  width: auto; display: inline-block;
  padding: 8px 12px; font-size: 12px; margin: 0;
}

.howto-list {
  text-align: left; list-style: none; margin: 0 0 18px;
  color: #d0d6e4; font-size: 14px; line-height: 1.55;
}
.howto-list li {
  padding: 8px 0 8px 18px; position: relative;
  border-bottom: 1px solid rgba(255,255,255,0.06);
}
.howto-list li::before {
  content: "▸"; position: absolute; left: 0; color: #7CFF3A;
}

/* —— Garage —— */
#garage.overlay {
  align-items: stretch; justify-content: center;
  padding: max(10px, env(safe-area-inset-top)) 12px max(10px, env(safe-area-inset-bottom));
  overflow: auto;
  touch-action: pan-y;
}
.garage-shell {
  width: min(720px, 100%);
  display: flex; flex-direction: column; gap: 10px;
  margin: auto;
}
.garage-top {
  display: flex; align-items: center; justify-content: space-between; gap: 8px;
}
.garage-top h2 {
  font-size: clamp(20px, 5vw, 28px); font-weight: 900; letter-spacing: 2px; margin: 0;
}
.garage-top .cash-pill { margin: 0; }

.garage-preview {
  background: rgba(12,16,28,0.9);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 16px;
  padding: 8px 8px 12px;
}
#garage-canvas {
  display: block; width: 100%; height: auto;
  max-height: 180px; border-radius: 10px;
  background: linear-gradient(180deg, #1a2438 0%, #2a3348 55%, #1c222e 55%, #252b36 100%);
}
.car-nav {
  display: flex; align-items: center; gap: 8px; margin-top: 6px;
}
.nav-arrow {
  width: 44px; height: 44px; border-radius: 12px;
  border: 1px solid rgba(255,255,255,0.25);
  background: rgba(255,255,255,0.06); color: #fff;
  font-size: 28px; line-height: 1; cursor: pointer; flex-shrink: 0;
}
.car-meta { flex: 1; text-align: center; min-width: 0; }
#garage-car-name {
  font-weight: 800; font-size: clamp(14px, 3.5vw, 18px);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.car-stats-line {
  color: #9aa3b8; font-size: 11px; margin-top: 2px;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.car-dots {
  display: flex; justify-content: center; gap: 6px; margin-top: 8px;
}
.car-dots span {
  width: 8px; height: 8px; border-radius: 50%;
  background: rgba(255,255,255,0.25);
}
.car-dots span.on { background: #7CFF3A; }

.garage-tabs {
  display: flex; gap: 6px;
}
.garage-tabs .tab {
  flex: 1; padding: 10px; border-radius: 10px;
  border: 1px solid rgba(255,255,255,0.15);
  background: rgba(255,255,255,0.04); color: #aab;
  font-weight: 800; font-size: 12px; letter-spacing: 1px; cursor: pointer;
}
.garage-tabs .tab.active {
  background: rgba(124,255,58,0.15);
  border-color: rgba(124,255,58,0.5); color: #7CFF3A;
}

.upgrade-panel {
  background: rgba(12,16,28,0.85);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: 14px;
  padding: 8px;
  max-height: min(32vh, 260px);
  overflow-y: auto;
  touch-action: pan-y;
}
.up-row {
  display: flex; align-items: center; gap: 10px;
  padding: 10px 8px;
  border-bottom: 1px solid rgba(255,255,255,0.06);
}
.up-row:last-child { border-bottom: none; }
.up-info { flex: 1; min-width: 0; text-align: left; }
.up-info .up-name { font-weight: 800; font-size: 13px; }
.up-info .up-desc { color: #8a93a8; font-size: 11px; margin-top: 2px; }
.up-lvl {
  font-size: 11px; color: #7CFF3A; font-weight: 700;
  white-space: nowrap;
}
.up-buy {
  padding: 8px 12px; border-radius: 10px;
  border: none; background: #7CFF3A; color: #0a1208;
  font-weight: 800; font-size: 12px; cursor: pointer; white-space: nowrap;
}
.up-buy:disabled {
  background: rgba(255,255,255,0.08); color: #778; cursor: default;
}
.up-buy.maxed { background: rgba(124,255,58,0.2); color: #7CFF3A; }

.cos-grid {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(72px, 1fr));
  gap: 8px; padding: 6px;
}
.cos-swatch {
  aspect-ratio: 1; border-radius: 10px;
  border: 2px solid rgba(255,255,255,0.2);
  cursor: pointer; position: relative;
  display: flex; align-items: flex-end; justify-content: center;
  padding-bottom: 4px; font-size: 9px; font-weight: 700;
  text-shadow: 0 1px 3px #000; color: #fff;
  background: #333;
}
.cos-swatch.selected { border-color: #7CFF3A; box-shadow: 0 0 0 1px #7CFF3A; }
.cos-swatch .cos-price {
  position: absolute; top: 4px; right: 4px;
  background: rgba(0,0,0,0.65); border-radius: 6px;
  padding: 1px 4px; font-size: 8px; color: #7CFF3A;
}
.cos-section-title {
  font-size: 11px; font-weight: 800; letter-spacing: 1px;
  color: #9aa3b8; padding: 8px 8px 4px; text-align: left;
}

.garage-foot { margin-top: 4px; }
.garage-foot .primary { margin: 0; }

@media (orientation: portrait) and (max-width: 700px) {
  .nitro { top: 36%; width: 76px; height: 76px; }
  .tach { width: min(180px, 48vw); height: min(180px, 48vw); bottom: max(70px, env(safe-area-inset-bottom)); }
  .shift {
    bottom: max(12px, env(safe-area-inset-bottom));
    width: 78px; height: 78px; font-size: 48px;
  }
  .upgrade-panel { max-height: 28vh; }
}

.engine-card { font-size: 0.72rem; }
.engine-card .meta { opacity: 0.8; }
.engine-card.tricky { border-color: #ff6a3a; }

/* —— Settings / FPS / banner polish —— */
.fps-counter {
  position: absolute; top: max(10px, env(safe-area-inset-top));
  left: 50%; transform: translateX(-50%);
  z-index: 30; pointer-events: none;
  font-size: 12px; font-weight: 800; letter-spacing: 1px;
  background: rgba(0,0,0,0.55); color: #7CFF3A;
  padding: 4px 10px; border-radius: 8px;
  font-variant-numeric: tabular-nums;
  border: 1px solid rgba(124,255,58,0.35);
}
.settings-card {
  width: min(460px, 100%);
  max-height: min(92vh, 720px);
  overflow-y: auto;
  touch-action: pan-y;
  text-align: left;
}
.settings-card h2 { text-align: center; }
.settings-card .tagline { text-align: center; }
.settings-section { margin: 12px 0 14px; }
.settings-label {
  font-size: 11px; font-weight: 800; letter-spacing: 1.5px;
  color: #9aa3b8; margin-bottom: 8px;
}
.settings-hint { color: #6a7388; font-size: 11px; margin-top: 6px; line-height: 1.35; }
.preset-row { display: flex; gap: 6px; flex-wrap: wrap; }
.preset-btn {
  flex: 1; min-width: 58px; padding: 10px 6px; border-radius: 10px;
  border: 1px solid rgba(255,255,255,0.18);
  background: rgba(255,255,255,0.05); color: #ccd;
  font-weight: 800; font-size: 12px; letter-spacing: 0.5px; cursor: pointer;
}
.preset-btn.active {
  background: rgba(124,255,58,0.18);
  border-color: rgba(124,255,58,0.55); color: #7CFF3A;
}
.toggle-row, .slider-row {
  display: flex; align-items: center; justify-content: space-between; gap: 10px;
  padding: 8px 2px; font-size: 13px; color: #d8deea;
  border-bottom: 1px solid rgba(255,255,255,0.05);
}
.toggle-row input[type="checkbox"] { width: 18px; height: 18px; accent-color: #7CFF3A; }
.slider-row input[type="range"] { flex: 1; max-width: 62%; accent-color: #7CFF3A; }

.banner .go {
  animation: banner-pop 0.28s ease-out;
}
.banner .sub.perfect-glow {
  color: #b8ff7a;
  text-shadow: 0 0 18px rgba(124,255,58,0.85), 0 4px 12px #000;
}
.banner .sub.good-glow {
  color: #9dff6a;
  text-shadow: 0 0 12px rgba(124,255,58,0.55);
}
@keyframes banner-pop {
  from { transform: scale(0.72); opacity: 0.2; }
  to { transform: scale(1); opacity: 1; }
}
.banner.show .go { display: inline-block; }
